# Somente o modo demo funciona sem integração externa.
APP_MODE=demo
MODEL_MODE=demo
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data/agent-customer
# Troque o token para qualquer execução fora do seu ambiente local.
DEMO_TOKEN=demo-local-token

# Para usar um modelo real no laboratório:
# MODEL_MODE=llm
# OPENAI_API_KEY=
# AGENT_MODEL=

# PostgreSQL externo é opcional no laboratório:
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_customer
# AGENT_ENABLED=true
