{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "outDir": "dist", "types": ["node"], "sourceMap": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "evals/**/*.ts"]
}
