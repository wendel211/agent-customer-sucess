{
  "name": "agent-customer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Copiloto de tickets com LangChain e LangGraph",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "eval:agent-customer": "tsx evals/agent-customer/run.ts",
    "test:built": "npm run build && node --test tests/built.test.mjs"
  },
  "dependencies": {
    "langchain": "1.5.19",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@langchain/openai": "1.7.0",
    "@electric-sql/pglite": "0.5.11",
    "zod": "4.6.7",
    "fastify": "5.12.7",
    "@fastify/rate-limit": "10.3.0",
    "pg": "8.23.1",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1"
  }
}
